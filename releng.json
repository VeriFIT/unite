{
  "apps": [
    {
      "app_name": "unite",
      "ports": [
        {
          "target_port": 31080,
          "port": 31080,
          "node_port": 31080
        },
        {
          "target_port": 31081,
          "port": 31081,
          "node_port": 31081
        }
      ],
      "custom_dockerfiles": [
        {
          "dockerfile_path": "docker/unite-base/Dockerfile",
          "image_name": "unite-base",
          "building_path": "docker/unite-base",
          "build_arguments": [
            {
              "argument": "UNITE_VERSION",
              "value": "${VERSION}"
            }
          ]
        },
        {
          "dockerfile_path": "docker/unite-all/Dockerfile",
          "image_name": "unite-all",
          "building_path": "docker/unite-all",
          "build_arguments": [
            {
              "argument": "UNITE_VERSION",
              "value": "${VERSION}"
            }
          ]
        }
      ]
    }
  ]
}